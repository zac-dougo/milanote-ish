{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Milanote-ish",
  "version": "0.1.0",
  "identifier": "com.zacdougo.milanoteish",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Milanote-ish",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#f2efe6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/assets/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  }
}
